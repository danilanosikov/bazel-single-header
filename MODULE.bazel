# project
module(
	name = "okular-system",
	version = "12111026a0"
)


# расширение функций для подключения зависимостей
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")
single_header = use_repo_rule("//tools:single_header.bzl", "single_header")
new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")



# зависимости
# c23/c++23 support
bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_multirun", version = "0.14.0", dev_dependency = True)

# clangd
bazel_dep(name = "hedron_compile_commands")
git_override(
    module_name = "hedron_compile_commands",
    remote = "https://github.com/helly25/bazel-compile-commands-extractor.git",
    commit = "078ba7675c05bea2666c92d9a8abe200d8547655",
)

# wayland
new_local_repository(
    name = "wayland",
    path = "/usr/share/wayland-protocols",
    build_file_content = 'exports_files(glob(["**/*.xml"]))',
)



single_header(
	name = "rgfw",
	header = "rgfw.h",
	url = "https://github.com/ColleagueRiley/RGFW/releases/download/1.8.1/RGFW.h",
	sha256 = "ece357894cf1e5d178c5343d877c4b8c66e6d0a42164b2b2e49220142700448d",
)
