# project
module(
	name = "okular-system-memory",
	version = "12111026a0"
)
bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "platforms", version = "1.1.0")

# clangd
bazel_dep(name = "rules_python", version = "1.7.0", dev_dependency = True)
git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")
git_repository(
	name = "clangd",
	remote = "https://github.com/helly25/bazel-compile-commands-extractor.git",
	commit = "078ba7675c05bea2666c92d9a8abe200d8547655",
	patch_cmds = ["sed -i 's/@hedron_compile_commands//g' refresh_compile_commands.bzl"],
	build_file_content = """
load("@rules_cc//cc:defs.bzl", "cc_binary")
load(":refresh_compile_commands.bzl", "refresh_compile_commands")
exports_files([
    "refresh.template.py",
    "check_python_version.template.py",
])
cc_binary(
    name = "print_args",
    srcs = ["print_args.cpp"],
    visibility = ["//visibility:public"],
)
refresh_compile_commands(
    name = "generate",
)
""",
)
