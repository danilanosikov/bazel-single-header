# @описание: компиляция
load("@rules_cc//cc:defs.bzl", "cc_library")

# @описание: библиотека распознавания особенностей системы
cc_library(
	name = "headers",
	hdrs = ["system.h", "error.h"],
	defines = select({
		# определение компилятора
		"@rules_cc//cc/compiler:clang": ["oku_system_compiler=clang"],
		"@rules_cc//cc/compiler:clang-cl": ["oku_system_compiler=clang"],
		"@rules_cc//cc/compiler:gcc": ["oku_system_compiler=gcc"],
		"@rules_cc//cc/compiler:msvc-cl": ["oku_system_compiler=msvc"],
		"//conditions:default": ["oku_system_compiler=unknown"],
	}),
	includes = ["."],
	visibility = ["//library:__subpackages__"],
)

cc_library(
	name = "library",
	deps = [":headers"] + select({
		"@platforms//os:linux": ["//library/backend/linux:backend"],
	}),
	visibility = ["//visibility:public"],
)

# @описание: библиотека с проверками состояния для тестирования
cc_library(
	name = "library_test",
	deps = [":headers"] + select({
		"@platforms//os:linux": ["//library/backend/linux:backend_test"],
	}),
	visibility = ["//test:__subpackages__"],
)
