load("@rules_cc//cc:defs.bzl", "cc_library")
genrule(
	name = "wayland",
	srcs = [
		"@wayland_protocols//:stable/xdg-shell/xdg-shell.xml",
		"@wayland_protocols//:unstable/xdg-decoration/xdg-decoration-unstable-v1.xml",
		"@wayland_protocols//:staging/xdg-toplevel-icon/xdg-toplevel-icon-v1.xml",
		"@wayland_protocols//:unstable/relative-pointer/relative-pointer-unstable-v1.xml",
		"@wayland_protocols//:unstable/pointer-constraints/pointer-constraints-unstable-v1.xml",
		"@wayland_protocols//:unstable/xdg-output/xdg-output-unstable-v1.xml",
	],
	outs = [
		"xdg-shell.h",
		"xdg-shell.c",
		"xdg-toplevel-icon-v1.h",
		"xdg-toplevel-icon-v1.c",
		"xdg-decoration-unstable-v1.h",
		"xdg-decoration-unstable-v1.c",
		"relative-pointer-unstable-v1.h",
		"relative-pointer-unstable-v1.c",
		"pointer-constraints-unstable-v1.h",
		"pointer-constraints-unstable-v1.c",
		"xdg-output-unstable-v1.h",
		"xdg-output-unstable-v1.c",
	],
	cmd = """
		for xml in $(SRCS); do
			out=$$(basename "$$xml" .xml)
			wayland-scanner client-header "$$xml" "$(@D)/$$out.h"
			wayland-scanner private-code "$$xml" "$(@D)/$$out.c"
		done
	""",
)

_BACKEND_SRCS = [
	"module.c",
	"memory.c",
	"display.c",
	"input.c",
	":wayland",
]

_BACKEND_LINKOPTS = [
	"-lwayland-client",
	"-lwayland-cursor",
	"-lxkbcommon",
	"-lvulkan",
]

_BACKEND_DEFINES = [
	"oku_system=linux",
	"oku_system_family=unix",
	"oku_system_type=universal",
	"oku_system_libre=true",
	"RGFW_WAYLAND",
	"RGFW_VULKAN",
	"RGFW_IMPLEMENTATION",
]

_BACKEND_DEPS = [
	"//library:headers",
	":wayland",
	"@rgfw//:rgfw",
	"@vulkan_headers//:vulkan",
]

cc_library(
	name = "backend",
	srcs = _BACKEND_SRCS,
	linkopts = _BACKEND_LINKOPTS,
	copts = ["-Wno-static-in-inline"],
	defines = _BACKEND_DEFINES,
	deps = _BACKEND_DEPS,
	includes = ["."],
	visibility = ["//library:__subpackages__"],
)

# проверки состояния модуля включены только в этой сборке
cc_library(
	name = "backend_test",
	srcs = _BACKEND_SRCS,
	linkopts = _BACKEND_LINKOPTS,
	copts = ["-Wno-static-in-inline"],
	defines = _BACKEND_DEFINES + ["oku_system_test"],
	deps = _BACKEND_DEPS,
	includes = ["."],
	visibility = ["//library:__subpackages__"],
)
