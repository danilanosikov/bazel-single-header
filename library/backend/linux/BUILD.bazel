load("@rules_cc//cc:defs.bzl", "cc_library")

_BACKEND_SRCS = [
	"module.c",
	"memory.c",
	"display.c",
	"input.c",
]

_BACKEND_LINKOPTS = [
	"-lwayland-client",
	"-lwayland-cursor",
	"-lxkbcommon",
	"-lvulkan",
]

_BACKEND_DEFINES = [
	"oku_system=linux",
	"oku_system_family=unix",
	"oku_system_type=universal",
	"oku_system_libre=true",
	"RGFW_WAYLAND",
	"RGFW_VULKAN",
	"RGFW_IMPLEMENTATION",
]

filegroup(
	name = "backend_sources",
	srcs = _BACKEND_SRCS,
	visibility = ["//test:__pkg__"],
)

cc_library(
	name = "backend",
	srcs = _BACKEND_SRCS,
	linkopts = _BACKEND_LINKOPTS,
	copts = ["-Wno-static-in-inline"],
	defines = _BACKEND_DEFINES,
	deps = [
		"//library:headers",
		"@wayland//:wayland_client",
		"@wayland_protocols//:wayland_protocols",
		"@rgfw//:rgfw",
		"@vulkan_headers//:vulkan_headers",
	],
	includes = ["."],
	# generated protocol code uses hidden-visibility interface symbols; keep
	# all objects in one link unit so consumers can resolve them.
	linkstatic = True,
	visibility = ["//library:__subpackages__"],
)
