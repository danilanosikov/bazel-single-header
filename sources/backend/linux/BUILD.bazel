load("@rules_cc//cc:defs.bzl", "cc_library")
genrule(
	name = "wayland",
	srcs = [
		"@wayland//:stable/xdg-shell/xdg-shell.xml",
		"@wayland//:unstable/xdg-decoration/xdg-decoration-unstable-v1.xml",
		"@wayland//:staging/xdg-toplevel-icon/xdg-toplevel-icon-v1.xml",
		"@wayland//:unstable/relative-pointer/relative-pointer-unstable-v1.xml",
		"@wayland//:unstable/pointer-constraints/pointer-constraints-unstable-v1.xml",
		"@wayland//:unstable/xdg-output/xdg-output-unstable-v1.xml",
	],
	outs = [
		"xdg-shell.h",
		"xdg-shell.c",
		"xdg-toplevel-icon-v1.h",
		"xdg-toplevel-icon-v1.c",
		"xdg-decoration-unstable-v1.h",
		"xdg-decoration-unstable-v1.c",
		"relative-pointer-unstable-v1.h",
		"relative-pointer-unstable-v1.c",
		"pointer-constraints-unstable-v1.h",
		"pointer-constraints-unstable-v1.c",
		"xdg-output-unstable-v1.h",
		"xdg-output-unstable-v1.c",
	],
	cmd = """
		for xml in $(SRCS); do
			out=$$(basename "$$xml" .xml)
			out=$${out%-unstable-v*}
			wayland-scanner client-header "$$xml" "$(@D)/$$out.h"
			wayland-scanner private-code "$$xml" "$(@D)/$$out.c"
		done
	""",
)

cc_library(
	name = "backend",
	srcs = [
		"module.c",
		"memory.c",
		"display.c",
		"input.c",
		":wayland",
	],
	linkopts = [
		"-lwayland-client",
		"-lwayland-cursor",
		"-lxkbcommon",
		"-lvulkan",
	],
	defines = [
		"oku_system=linux",
		"oku_system_family=unix",
		"oku_system_type=universal",
		"oku_system_libre=true",
		"RGFW_WAYLAND",
		"RGFW_VULKAN",
		"RGFW_IMPLEMENTATION",
	],
	deps = [
		"//sources:headers",
		":wayland",
		"@rgfw//:rgfw",
	],
	includes = ["."],
	visibility = ["//sources:__subpackages__"],
)
