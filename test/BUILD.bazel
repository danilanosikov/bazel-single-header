# @описание: тестирование
load("@rules_cc//cc:defs.bzl", "cc_library")

# проверки состояния модуля включены только в этой сборке
cc_library(
	name = "backend_test",
	testonly = True,
	srcs = ["//library/backend/linux:backend_sources"],
	linkopts = [
		"-lwayland-client",
		"-lwayland-cursor",
		"-lxkbcommon",
		"-lvulkan",
	],
	copts = ["-Wno-static-in-inline"],
	defines = [
		"oku_system=linux",
		"oku_system_family=unix",
		"oku_system_type=universal",
		"oku_system_libre=true",
		"oku_system_test",
		"RGFW_WAYLAND",
		"RGFW_VULKAN",
		"RGFW_IMPLEMENTATION",
	],
	deps = [
		"//library:headers",
		"@wayland//:wayland_client",
		"@wayland_protocols//:wayland_protocols",
		"@rgfw//:rgfw",
		"@vulkan_headers//:vulkan_headers",
	],
	includes = ["../library/backend/linux"],
	# protocol interface symbols are hidden; link consumers in one unit.
	linkstatic = True,
	visibility = ["//test:__subpackages__"],
)

cc_library(
	name = "library_test",
	testonly = True,
	deps = [
		":backend_test",
		"//library:headers",
	],
	# protocol interface symbols are hidden; link consumers in one unit.
	linkstatic = True,
	visibility = ["//test:__subpackages__"],
)
