# @описание: тестирование окна
load("@rules_cc//cc:defs.bzl", "cc_test")

_COMMON = [
	"common.c",
	"common.h",
]

_ENV = [
	"DISPLAY",
	"WAYLAND_DISPLAY",
	"XDG_RUNTIME_DIR",
	"XAUTHORITY",
]

cc_test(
	name = "create",
	srcs = _COMMON + ["create.c"],
	deps = ["//test:library_test"],
	env_inherit = _ENV,
	tags = ["local"],
)

cc_test(
	name = "update",
	srcs = _COMMON + ["update.c"],
	deps = ["//test:library_test"],
	env_inherit = _ENV,
	tags = ["local"],
)

cc_test(
	name = "destroy",
	srcs = _COMMON + ["destroy.c"],
	deps = ["//test:library_test"],
	env_inherit = _ENV,
	tags = ["local"],
)
